# Copy to .env.local and fill in.
# Local backend: run `npx supabase start`, then `npx supabase status` and copy API URL + Publishable key.
# Cloud backend: Supabase dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

